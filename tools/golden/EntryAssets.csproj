<Project Sdk="Microsoft.NET.Sdk">

  <!--
    EntryAssets：把 **0.1.3 的参考实现**（仓库内冻结副本
    `reference/0.1.3-parser/src/Dictionary/EntryDocument.cs`）里的两件东西
    抽出来，变成 C 内核能直接用的生成物：

      ① `BaseStyle`（那份基础样式）与 `BridgeScript`（注入词条正文的桥接脚本）
         —— 通过反射读那两个 `private const string`，**原样**（一个字节都不改）写成 C 头；
      ② 若干份**完整文档**（`EntryDocument.Build` 的输出）—— 当标准答案文件，给 C 版的
         文档拼装逐字节对照测试。

    为什么要走这条路：那两段字符串加起来七百多行（含中文注释与 CSS），
    **手抄一遍必然出错**，而"抄错一个转义符"的症状是词条页莫名其妙地坏 ——
    最难查的一类。让参考实现自己吐出这两段，抄写这一步就不存在了。

    与 GoldenDump / HtmlVectors 同一个模式：net48、链仓库内那份只读参考源码不复制、
    只链这一个文件（EntryDocument 不依赖 Models / Newtonsoft）。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>EntryAssets</AssemblyName>
    <RootNamespace>Lookup.Tools.EntryAssets</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="entry-assets.cs" />
    <Compile Include="../../reference/0.1.3-parser/src/Dictionary/EntryDocument.cs" />
  </ItemGroup>

</Project>
